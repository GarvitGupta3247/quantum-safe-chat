{
  "name": "quantumsafe-chat-poc",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Experimental post-quantum messaging prototype with live cryptographic tracing, benchmarks, and security tests.",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:web:dev\"",
    "server:dev": "node --watch server/index.js",
    "web:dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "web:lan": "vite --host 0.0.0.0",
    "dev:lan": "concurrently -k \"npm:server:dev\" \"npm:web:lan\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "mlkem": "^2.7.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
